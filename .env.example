OPENAI_API_KEY=
VOYAGE_API_KEY=

# Dùng alias khi phát triển. Trước khi chạy bảng paper, nên khóa snapshot
# gpt-5-mini-2025-08-07 trong OPENAI_MODEL để tái lập kết quả.
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TIMEOUT_SECONDS=120
OPENAI_ATTEMPTS=2
OPENAI_BASE_URL=https://api.openai.com/v1

# Frozen B0 direct-allocation configuration. Temperature is intentionally not
# sent because this reasoning-model/API combination has no approved temperature
# control in the project protocol.
B0_MODEL=gpt-5-mini-2025-08-07
B0_REASONING_EFFORT=low
B0_MAX_OUTPUT_TOKENS=6000
B0_TIMEOUT_SECONDS=120
B0_ATTEMPTS=2

VOYAGE_MODEL=voyage-4-large
VOYAGE_OUTPUT_DIMENSION=1024
VOYAGE_BASE_URL=https://api.voyageai.com/v1
